+
+/* Netns pre_exit precedes pernet storage release and module teardown. */
+static void nft_fullcone_net_pre_exit(struct net *net)
+{
+	struct nft_fullcone_net *fn = net_generic(net, nft_fullcone_net_id);
+
+	mutex_lock(&nf_ct_net_event_lock);
+	if (fn->registered) {
+		nf_conntrack_unregister_notifier(net, &fn->notifier);
+		fn->registered = false;
+	}
+	mutex_unlock(&nf_ct_net_event_lock);
+}
+
+static struct pernet_operations nft_fullcone_net_ops = {
+	.id = &nft_fullcone_net_id,
+	.size = sizeof(struct nft_fullcone_net),
+	.pre_exit = nft_fullcone_net_pre_exit,
+};
 
